    {
      "id": "_ZYHddJQLlOnyflPONRob",
      "type": "text",
      "x": 1065,
      "y": 394,
      "width": 195.07984924316406,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",

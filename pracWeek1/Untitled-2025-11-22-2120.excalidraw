    {
      "id": "PoEfEOXaTABb5pyEsV-TU",
      "type": "text",
      "x": -140.57400065104196,
      "y": 1147,
      "width": 363.47332763671875,
      "height": 235.66666666666706,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

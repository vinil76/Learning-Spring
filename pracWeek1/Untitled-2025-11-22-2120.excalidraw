    {
      "id": "G6auD1d3kdfisnVuXL_t7",
      "type": "text",
      "x": -215.33726283482116,
      "y": 1467,
      "width": 332.1250027901784,
      "height": 105.99999999999996,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

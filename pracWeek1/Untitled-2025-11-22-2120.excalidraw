      "link": null,
      "locked": false,
      "text": "\n\nRequest Scope\n\nNew bean object for every HTTP request.\nDestroyed after request completes.\n\n@Scope(\"request\")\n@Component\npublic class UserRequestData {}\n\n\n\nSession Scope\n\nOne bean object per user session.\nUntil the user logs out or session expires.\n\n@Scope(\"session\")\n@Component\npublic class UserSessionData {}\n\n\n\n\nApplication Scope\n\nOne bean for the entire web application lifecycle.\nSimilar to singleton but works for servlet context.\n\n@Scope(\"application\")\n@Component\npublic class AppData {}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nRequest Scope\n\nNew bean object for every HTTP request.\nDestroyed after request completes.\n\n@Scope(\"request\")\n@Component\npublic class UserRequestData {}\n\n\n\nSession Scope\n\nOne bean object per user session.\nUntil the user logs out or session expires.\n\n@Scope(\"session\")\n@Component\npublic class UserSessionData {}\n\n\n\n\nApplication Scope\n\nOne bean for the entire web application lifecycle.\nSimilar to singleton but works for servlet context.\n\n@Scope(\"application\")\n@Component\npublic class AppData {}",
      "autoResize": true,
      "lineHeight": 1.25
    }
